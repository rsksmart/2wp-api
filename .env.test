LOW_MINING_BLOCK=12
BLOCKBOOK_URL='https://blockbook-01.testnet.2wp.iovlabs.net:19130/'
MAX_AMOUNT_ALLOWED_IN_SATOSHI=100000000

# Federation Addresses history
FEDERATION_ADDRESSES_HISTORY='2N6JWYUb6Li4Kux6UB2eihT7n3rm3YX97uv 2N1y7hSneV9HuWnpLTtGqdRnway1Ag3dQoj 2NF9ndVaez5owUShjSxNnY2E31QkRjLu63k 2N5exbrgeGBuKXqcinfz68atduq6ApHN4b4 2Mu7ayegt8AYi7vGYtG2KGaXErPWBQhPVfu 2N1rW3cBZNzs2ZxSfyNW7cMcNBktt6fzs88 2N1GMB8gxHYR5HLPSRgf9CJ9Lunjb9CTnKB'

# sessionDB
SESSIONDB_HOST='localhost'
SESSIONDB_PORT=6379
SESSIONDB_PASSWORD='2wp-api-password'
SESSIONDB_INDEX=1
RSK_NODE_HOST='https://public-node.testnet.rsk.co'
TTL_SESSIONDB_EXPIRE_MILLISECONDS=3600000
METRICS_ENABLED=false;

# DAEMON SYNC - https://explorer.testnet.rsk.co/block/2019830
SYNC_INITIAL_BLOCK_HEIGHT=3916761
SYNC_INITIAL_BLOCK_HASH='0xc97b565a3652ce60841ef91bd266a5861c229592bb8bd8412d7aaea02aad3ab7'
SYNC_INITIAL_BLOCK_PREV_HASH='0x6889c413fa56f29601932aa9fec90ba9d9dad5a25ab6371a3916688100ff7300'
SYNC_MIN_DEPTH=6
SYNC_INTERVAL_TIME=2000

# MONGODB CONNECTION
RSK_DB_CONNECTION_USER='api-user'
RSK_DB_CONNECTION_PASSWORD='pwd'
RSK_DB_CONNECTION_HOST='localhost'
RSK_DB_CONNECTION_PORT='27017'
RSK_DB_CONNECTION_DATABASE='rsk'
RSK_DB_CONNECTION_AUTH_SOURCE='rsk'

#FeePerKB (Sat/b)
FEE_PER_KB_FAST_MIN=100
FEE_PER_KB_AVERAGE_MIN=100
FEE_PER_KB_SLOW_MIN=100
MAX_FEE_AMOUNT_ALLOWED=5000000

#Dust value (Satoshi)
BURN_DUST_VALUE=2000

# Resource budgets — see docs/resource-budgets.md
# Every value below is the built-in default; each is optional and falls back to
# the same value when unset. Listed explicitly so they are easy to tune per
# environment.

# Inbound request body (bytes). 256 KiB.
MAX_REQUEST_BODY_BYTES=262144

# One outbound provider response (bytes). 1.5 MiB. Worst-case buffered provider
# data is this value times BLOCKBOOK_MAX_IN_FLIGHT, so raising either knob should
# be considered against that product.
MAX_PROVIDER_RESPONSE_BYTES=1572864

# Blockbook operations in flight across the whole process, callers allowed to
# queue for a permit, and how long one may wait before being refused with 503.
BLOCKBOOK_MAX_IN_FLIGHT=50
BLOCKBOOK_QUEUE_MAX_DEPTH=100
BLOCKBOOK_QUEUE_MAX_WAIT_MS=5000

# Outbound provider deadline (ms), extra attempts after the first, and backoff.
PROVIDER_TIMEOUT_MS=15000
PROVIDER_MAX_RETRIES=1
PROVIDER_RETRY_BASE_DELAY_MS=100
PROVIDER_CONCURRENCY=5

# UTXO rows retained per address and per /utxo request.
MAX_UTXOS_PER_ADDRESS=1000
UTXO_RESPONSE_MAX_ROWS=1000

# txids retained per address in /addresses-info (pinned as Blockbook's pageSize).
MAX_ADDRESS_INFO_TXIDS=100

# Serialized error-response ceiling, and the validation details returned with it.
MAX_ERROR_RESPONSE_BYTES=8192
MAX_VALIDATION_ERROR_DETAILS=3

# Response bytes buffered for one connection before it is dropped.
MAX_CONNECTION_BUFFERED_BYTES=1048576

# Wall-clock deadline for handling one inbound request.
MAX_REQUEST_DURATION_MS=30000

# Grace given to cooperative unwinding after a request's deadline trips, before
# the response is written on its behalf (ms).
REQUEST_DEADLINE_GRACE_MS=250
