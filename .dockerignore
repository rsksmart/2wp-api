# Build inputs the image rebuilds for itself. Copying a host tree in would ship
# whatever architecture and versions that host happened to have.
node_modules
npm-debug.log
/dist
# Cache used by TypeScript's incremental build
*.tsbuildinfo

# Credentials. The Dockerfile does `COPY . ./` and Docker does not read
# .gitignore, so without these every environment file — including the database
# user and password — is baked into an image layer that travels wherever the
# image is pushed. Values are supplied at run time via env_file or the
# orchestrator, so nothing in the image needs them.
.env
.env.*

# Repository history, including anything ever committed and later removed.
.git
.gitignore

# Local agent state and the security informs, which are deliberately the only
# place the report identifiers appear.
.claude

# Local scratch and editor state that has no business in an image.
_to_delete
.vscode
.idea
.DS_Store
coverage
.nyc_output
